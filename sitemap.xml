<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for page in site.pages -%}
    {%- if page.path contains '.html' and page.layout != nil and page.layout != 'redirect' and page.sitemap != false -%}
      <url>
        {%- if page.path contains 'index.html' -%}
          <loc>https://wantzzz.github.io/a1b2c3d4e5f67890f8e7d6c5b4a3f2e1d0c9b8a7{{ page.url | replace: 'index.html', '' }}</loc>
        {%- else -%}
          <loc>https://wantzzz.github.io/a1b2c3d4e5f67890f8e7d6c5b4a3f2e1d0c9b8a7{{ page.url }}</loc>
        {%- endif -%}
      </url>
    {%- endif -%}
  {%- endfor -%}
</urlset>