---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- assign all_urls = "" -%}
  {%- for page in site.pages -%}
    {%- if page.url contains '.html' and page.sitemap != false -%}
      {%- assign clean_url = page.url | replace: '/index.html', '/' -%}
      {%- assign all_urls = all_urls | append: clean_url | append: "," -%}
      {%- assign parts = page.url | split: '/' -%}
      {%- assign current_path = "/" -%}
      {%- for part in parts -%}
        {%- if part != "" and part contains '.html' == false -%}
          {%- assign current_path = current_path | append: part | append: "/" -%}
          {%- assign all_urls = all_urls | append: current_path | append: "," -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign unique_urls = all_urls | split: "," | uniq -%}
  {%- for u in unique_urls -%}
    {%- if u != "" and u != nil -%}
  <url>
    <loc>https://yourdomain.com/a1b2c3d4e5f67890f8e7d6c5b4a3f2e1d0c9b8a7{{ u }}</loc>
  </url>
    {%- endif -%}
  {%- endfor -%}
</urlset>